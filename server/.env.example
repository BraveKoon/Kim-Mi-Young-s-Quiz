# ClassQuiz 서버 환경 변수 (운영 환경에서는 반드시 값을 변경하세요)
PORT=3000
NODE_ENV=development
# 반드시 32자 이상의 임의 문자열로 변경 (예: openssl rand -hex 32)
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=8h
DATABASE_PATH=./data/classquiz.sqlite
# 여러 개는 쉼표로 구분 (예: https://quiz.school.kr,https://user.github.io)
CLIENT_ORIGIN=http://localhost:5173
# 최초 관리자 계정 (계정이 없을 때만 생성됨)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
# 기본 비밀번호 로그인 후 비밀번호 변경 강제 여부
ADMIN_FORCE_PASSWORD_CHANGE=true
# 학생 재접속 토큰 유효 시간(시간)
PARTICIPANT_TOKEN_TTL_HOURS=12
# 답안 수신 허용 지연(ms) — 네트워크 지연 보정
ANSWER_GRACE_MS=500
# 리버스 프록시(nginx 등) 뒤에서 실행할 경우 1
TRUST_PROXY=0
# 프론트엔드 빌드(dist)를 같은 서버에서 정적 제공할 경로 (비우면 비활성)
SERVE_CLIENT_DIST=
# 요청 속도 제한 (IP당 분당). 학교는 학생 전체가 하나의 공인 IP(NAT)를 공유하는 경우가 많으므로
# 학생 수를 고려해 넉넉하게 설정한다.
API_RATE_LIMIT_PER_MINUTE=3000
JOIN_RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=10
